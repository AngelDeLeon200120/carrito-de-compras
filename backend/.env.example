# Copia este archivo a .env antes de ejecutar el proyecto

# JWT
JWT_SECRET=super-secret-dev-key-change-me
JWT_EXPIRES_IN=2h

# DynamoDB Local (valores por defecto de serverless-dynamodb, no cambiar en local)
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Tablas
PRODUCTS_TABLE=Products
CARTS_TABLE=Carts
ORDERS_TABLE=Orders
USERS_TABLE=Users

# Email (SMTP). Si se dejan vacios, el servicio crea una cuenta de prueba
# Ethereal automaticamente e imprime la URL de previsualizacion en consola.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sports Cart <no-reply@sportscart.dev>"
